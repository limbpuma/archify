{
  "schema_version": 1,
  "diagram_type": "epk",
  "meta": {
    "title": "Phone Order Process Chain",
    "subtitle": "Extended event-driven process chain (eEPK) of one phone order from the incoming call to hand-over",
    "output": "examples/epk-phone-order.html",
    "viewBox": [
      1380,
      820
    ],
    "grid": {
      "colWidth": 250,
      "rowHeight": 60,
      "originX": 120,
      "originY": 100
    },
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "intake",
        "label": "Intake and payment",
        "focus": [
          "call_received",
          "take_order",
          "order_recorded",
          "check_payment",
          "payment_split"
        ],
        "note": "The agent takes the order from the menu, then the payment check decides how the chain continues."
      },
      {
        "id": "fulfil",
        "label": "Fulfilment in parallel",
        "focus": [
          "payment_ok",
          "prepare",
          "order_ready",
          "ready_split",
          "notify",
          "hand_over",
          "notified",
          "handed_over"
        ],
        "note": "Once the order is ready, notifying the customer and handing it to the courier run in parallel."
      },
      {
        "id": "decline",
        "label": "Declined payment",
        "focus": [
          "payment_declined",
          "cancel",
          "cancelled"
        ],
        "note": "A declined payment cancels the order and ends the chain."
      }
    ]
  },
