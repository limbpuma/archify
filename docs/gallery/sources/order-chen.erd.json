      {
        "id": "customers",
        "label": "Customers and orders",
        "focus": [
          "customer",
          "places",
          "order"
        ],
        "note": "A customer places zero or more orders; every order belongs to exactly one customer."
      },
      {
        "id": "lines",
        "label": "Order lines and products",
        "focus": [
          "order",
          "contains",
          "order_line",
          "refers_to",
          "product"
        ],
        "note": "An order contains at least one line; each line refers to exactly one product, and a product may appear in many lines."
      },
      {
        "id": "attributes",
        "label": "Keys, derived, and multivalued attributes",
        "focus": [
          "customer_no",
          "order_no",
          "order_total",
          "line_no",
          "product_no",
          "product_tags"
        ],
        "note": "Primary keys are underlined (customerNo, orderNo, lineNo, productNo); total is a derived attribute; allergens is multivalued."
      }
    ]
  },
