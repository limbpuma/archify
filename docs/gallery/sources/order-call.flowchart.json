  "cards": [
    {
      "dot": "emerald",
      "title": "One rule",
      "items": [
        "The agent proposes, the domain decides: prices, zones, minimums and risk are computed only by the API.",
        "Every diamond reads what the previous API call returned — never the agent's own knowledge."
      ]
    },
    {
      "dot": "amber",
      "title": "Two loops",
      "items": [
        "Quote loop: every change in the conversation is a new /orders/quote; blockers are the only source of questions.",
        "Retry loop: a timeout resends the same idempotency key — never a second pizza."
      ]
    },
    {
      "dot": "rose",
      "title": "Exits",
      "items": [
        "409 conflict alerts the owner and ends without order.",
        "422 item gone returns to the quote with the item removed."
      ]
    }
  ]
